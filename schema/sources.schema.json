{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Tracked sources (data/sources.json)",
  "description": "The sources the dashboard expects status for. Hand-authored; the watcher reports on these ids in status.json.",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "note": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
