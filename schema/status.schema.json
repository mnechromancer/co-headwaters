{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "Watcher status (data/status.json)",
  "description": "Per-source poll health written by the watcher. The dashboard shows freshness from this file only; a missing file renders an explicit missing state.",
  "type": "object",
  "required": ["generated", "sources"],
  "additionalProperties": false,
  "properties": {
    "generated": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "cadence", "last_success", "last_error"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "cadence": { "enum": ["hourly", "daily", "weekly"] },
          "last_success": { "type": ["string", "null"], "format": "date-time" },
          "last_error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
